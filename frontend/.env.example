# Base URL for the Jan-Setu API. Leave unset for same-origin /api and /auth.
VITE_API_BASE=

# Optional public path for built assets, including leading and trailing slashes.
# Leave unset for deployment at the domain root. Example: /portal/
VITE_ASSET_BASE=

# Optional Leaflet tile URL template. Review the provider's attribution and usage terms.
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
