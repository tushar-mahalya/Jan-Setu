ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=text
API_KEY=

POSTGRES_DB=jan_setu
POSTGRES_USER=jan_setu_app
POSTGRES_PASSWORD=jan_setu_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Only set when a deployment platform gives you one complete database URL;
# leave blank to build the URL from the POSTGRES_* fields above.
DATABASE_URL=

WHATSAPP_VERIFY_TOKEN=dev_verify_token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
REQUEST_TIMEOUT_SECONDS=10
# Digits-only WhatsApp Business number (no +) for wa.me/<number> deep links.
PUBLIC_WA_NUMBER=

AUTO_REPLY_ENABLED=true
WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=10

# Reverse geocoding. The PUBLIC Nominatim endpoint below is DEV-ONLY (1 req/s
# cap, app/bulk traffic forbidden by policy). For production set NOMINATIM_BASE_URL
# to a self-hosted Nominatim/Photon (India OSM extract) or a paid provider.
GEOCODER_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=JanSetu/0.1 (+https://github.com/tushar-mahalya/Jan-Setu)
GEOCODER_TIMEOUT_SECONDS=3
GEOCODER_MIN_INTERVAL_SECONDS=1
GEOCODER_LANGUAGE=hi,en

# Conversation engine
CONVERSATION_TTL_HOURS=168
SERVICE_WINDOW_HOURS=24

# Speech-to-text (Sarvam saaras:v3, mode=translate -> English transcripts)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=saaras:v3
SARVAM_MIN_INTERVAL_SECONDS=1
SARVAM_TIMEOUT_SECONDS=30

# LLM classification (OpenRouter). Free models rotate, so the chain is
# config-driven and classify.py falls through it, degrading gracefully.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,openai/gpt-oss-120b:free,nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MIN_INTERVAL_SECONDS=3
OPENROUTER_TIMEOUT_SECONDS=30

# Dedup window for non-priority complaints; priority categories skip it.
DEDUP_WINDOW_HOURS=24
DEDUP_RADIUS_M=300
IMAGE_RECHECK_CAP=2

# Department dispatch: mock_api (simulated municipal API) or smtp (Mailpit locally,
# a real authenticated SMTP relay in Azure production).
# For a visible local prototype demo, set DISPATCHER=smtp and open Mailpit at :8025.
DISPATCHER=mock_api
MOCK_API_BASE_URL=http://localhost:8000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@jan-setu.local

# File uploads (voice clips, photos, generated PDFs)
UPLOAD_DIR=./data/uploads
MAX_AUDIO_BYTES=10485760
MAX_IMAGE_BYTES=5242880

# Auth: reverse OTP over WhatsApp + JWT access / rotating refresh cookie
# Local-only example. Use a unique random secret of at least 32 bytes in staging/production.
JWT_SECRET=jan_setu_local_jwt_secret_only_change_me_32
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_PER_HOUR=3

# Web frontend
CORS_ORIGINS=http://localhost:5173
